# ===================================
# Auxílio Farmácia Backend - Environment Variables
# Copy to .env and fill in values
# ===================================

# APP
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_CORS_ORIGINS=["*"]

# SERVER
HOST=0.0.0.0
PORT=8000

# DATABASE
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./auxfarmacia.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://auxfarmacia:password@localhost:5432/auxfarmacia

# SECURITY
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-STRONG-RANDOM-KEY-MIN-32-CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# STRIPE (internacional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=price_xxx_pro
STRIPE_PRICE_ID_PREMIUM=price_xxx_premium
STRIPE_PRICE_ID_INSTITUTIONAL=price_xxx_institutional

# ASAAS (Brasil)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=

# EMAIL
EMAIL_FROM=noreply@auxfarmacia.com.br
EMAIL_FROM_NAME=Auxílio Farmácia
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SENDGRID_API_KEY=

# ADMIN
ADMIN_EMAILS=["admin@auxfarmacia.com.br"]
ADMIN_DEFAULT_PASSWORD=admin123

# REDIS (opcional)
REDIS_URL=redis://localhost:6379/0

# MONITORING
SENTRY_DSN=
